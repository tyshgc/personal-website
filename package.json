    "dotenv": "^17.4.2",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
