# Notion Internal Integration Token
# https://www.notion.so/profile/integrations から Internal Integration を作成し、
# 「Outputsデータ」DB と「外部サイト」DB の両方に Connection を追加してから、ここに secret_xxx を貼り付けてください。
NOTION_API_KEY=

# Outputsデータ Data Source ID
NOTION_OUTPUTS_DATA_SOURCE_ID=2eb5668a-3b01-8025-8a8a-000bd9a14bb0

# 外部サイト Data Source ID
NOTION_EXTERNALS_DATA_SOURCE_ID=d5f6a65b-d7d9-40f6-9c9d-333aab6444cf
